# Copy to .env and fill in. Never commit the real .env file.

# Port the HTTP + Socket.IO server listens on.
PORT=3000

# Interface to bind. Keep 0.0.0.0 in containers, previews and most PaaS hosts.
HOST=0.0.0.0

# TikTok account to read live events from, without the leading @.
# Leave empty to run the game without a TikTok connection.
TIKTOK_USERNAME=

# Optional: pin an exact room id instead of resolving it from the username.
TIKTOK_ROOM_ID=

# REQUIRED before going live. Secret for POST /admin/api.
# If unset, the server falls back to the public default "admindev".
ADMIN_TOKEN=

# Optional: where the daily leaderboard JSON is stored.
# Must be a writable path (mount a volume on hosts with an ephemeral filesystem).
LEADERBOARD_FILE=./data/leaderboard.json
